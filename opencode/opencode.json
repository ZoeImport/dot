{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "atlas": {
      "description": "Plan Executor - executes implementation plans task by task",
      "fallback_models": [
        "deepseek/deepseek-v4-flash"
      ],
      "mode": "subagent",
      "model": "unlimited/deepseek/deepseek-v4-flash"
    },
    "build": {
      "fallback_models": [
        "deepseek/deepseek-v4-flash"
      ],
      "model": "unlimited/deepseek/deepseek-v4-flash"
    },
    "deep": {
      "fallback_models": [
        "deepseek/deepseek-v4-flash"
      ],
      "model": "unlimited/deepseek/deepseek-v4-flash"
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "metis": {
      "fallback_models": [
        "deepseek/deepseek-v4-flash"
      ],
      "model": "unlimited/deepseek/deepseek-v4-flash"
    },
    "momus": {
      "fallback_models": [
        "deepseek/deepseek-v4-flash"
      ],
      "model": "unlimited/deepseek/deepseek-v4-flash"
    },
    "multimodal-looker": {
      "fallback_models": [
        "deepseek/deepseek-v4-flash"
      ],
      "model": "unlimited/deepseek/deepseek-v4-flash"
    },
    "oracle": {
      "fallback_models": [
        "deepseek/deepseek-v4-flash"
      ],
      "model": "unlimited/deepseek/deepseek-v4-flash"
    },
    "prometheus": {
      "color": "#FF5722",
      "description": "Plan agent for complex multi-step tasks. Consult Prometheus first before implementation. (Prometheus - OhMyOpenCode)",
      "fallback_models": [
        "deepseek/deepseek-v4-flash"
      ],
      "mode": "primary",
      "model": "unlimited/deepseek/deepseek-v4-flash"
    },
    "quick": {
      "fallback_models": [
        "deepseek/deepseek-v4-flash"
      ],
      "model": "unlimited/deepseek/deepseek-v4-flash"
    },
    "sisyphus": {
      "fallback_models": [
        "deepseek/deepseek-v4-flash"
      ],
      "model": "unlimited/deepseek/deepseek-v4-flash"
    },
    "sisyphus-junior": {
      "fallback_models": [
        "deepseek/deepseek-v4-flash"
      ],
      "model": "unlimited/deepseek/deepseek-v4-flash"
    },
    "ultrabrain": {
      "fallback_models": [
        "deepseek/deepseek-v4-flash"
      ],
      "model": "unlimited/deepseek/deepseek-v4-flash"
    },
    "visual-engineering": {
      "fallback_models": [
        "deepseek/deepseek-v4-flash"
      ],
      "model": "unlimited/deepseek/deepseek-v4-flash"
    }
  },
  "mcp": {
    "figma": {
      "command": [
        "npx",
        "-y",
        "figma-mcp"
      ],
      "environment": {
        "FIGMA_API_KEY": "xxx"
      },
      "type": "local"
    }
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "oh-my-openagent@latest"
  ],
  "provider": {
    "deepseek": {
      "models": {
        "deepseek-v4-flash": {
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "name": "DeepSeek V4 Flash (deepseek)",
          "variants": {
            "high": {
              "effort": "high"
            },
            "max": {
              "effort": "max"
            },
            "medium": {
              "effort": "medium"
            }
          }
        }
      },
      "name": "DeepSeek Official",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "xxx",
        "baseURL": "xxx"
      }
    },
    "unlimited": {
      "models": {
        "aliyun/kimi-k2.6": {
          "limit": {
            "context": 262144,
            "output": 4096
          },
          "name": "Kimi K2.6 (unlimited)"
        },
        "aliyun/qwen3.6-27b": {
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "Qwen3.6 27B (unlimited)"
        },
        "deepseek/deepseek-v4-flash": {
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "name": "DeepSeek V4 Flash (unlimited)",
          "variants": {
            "high": {
              "effort": "high"
            },
            "max": {
              "effort": "max"
            },
            "medium": {
              "effort": "medium"
            }
          }
        }
      },
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "xxx",
        "baseURL": "xxx"
      }
    }
  }
}